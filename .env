# Local API. `npm run dev` calls this origin directly.
# `npm run build` overrides this with /api/v1 so CloudFront can route /api/*.
VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_APP_NAME=BMC

# Rows requested per list page. The API allows 1–100.
VITE_TABLE_PAGE_SIZE=20

# React Query cache, in milliseconds.
# 0 means a list refetches whenever it is shown.
VITE_CACHE_STALE_TIME=0
# How long unused query data stays in memory (5 minutes).
VITE_CACHE_GC_TIME=300000
